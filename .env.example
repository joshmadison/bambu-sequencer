# ---- Public URL / TLS -------------------------------------------------------
# The hostname Caddy serves and requests a certificate for.
DOMAIN=plateloop.example.com
# Let's Encrypt account address (certificate expiry notices).
ACME_EMAIL=you@example.com

# ---- Image ------------------------------------------------------------------
# Empty = build from this checkout. Set to ghcr.io/<user>/plateloop:latest to
# deploy a prebuilt image instead.
PLATELOOP_IMAGE=

# ---- Upload / abuse limits --------------------------------------------------
# Keep this at 95 or below if you put Cloudflare in front (free plan caps
# request bodies at 100 MB).
MAX_UPLOAD_MB=100
# Caddy rejects larger request bodies before they reach the app. Keep this a
# little above MAX_UPLOAD_MB to leave room for multipart overhead.
MAX_BODY_MB=110
# POST /api/* requests per IP inside the window. 0 disables the limit.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=600
# Simultaneous upload/build requests across the whole instance.
MAX_CONCURRENT_REQUESTS=2

# ---- Support link -----------------------------------------------------------
# The upstream build shows the project's Ko-fi button by default. Set your own
# URL to replace it, or set SUPPORT_URL= (empty) to hide the button.
# SUPPORT_URL=https://ko-fi.com/yourname
SUPPORT_LABEL=Buy me a coffee

# ---- Legal pages (/impressum + /datenschutz, English: /imprint + /privacy) --
# Fill these before the site is publicly reachable. The pages show a visible
# warning while any of NAME / ADDRESS / EMAIL is missing.
LEGAL_NAME=Your Name
LEGAL_ADDRESS=Street 1, 12345 City, Germany
LEGAL_EMAIL=hello@example.com
LEGAL_VAT_ID=
# e.g. Hostinger International Ltd., 61 Lordou Vironos Street, 6023 Larnaca, Cyprus
# or   Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Germany
HOSTING_PROVIDER=Your hosting provider, street, city, country
LOG_RETENTION_DAYS=30
LEGAL_UPDATED=2026-10-24

# ---- Ads (leave empty until you actually run them) --------------------------
# Enabling ads in the EU requires a consent banner / CMP and an updated privacy
# policy. The privacy page only mentions a provider when this is set.
ADS_PROVIDER=
